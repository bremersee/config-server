#!/usr/bin/env bash

DEBIAN_NAME="config-server"
APP_NAME=$DEBIAN_NAME
USER_NAME="cfg-srv"
GROUP_NAME=$USER_NAME

if ! /usr/bin/getent passwd $USER_NAME
then
  /usr/sbin/adduser --system --home /var/lib/$DEBIAN_NAME --shell /bin/false --no-create-home --group --disabled-login $USER_NAME
fi

/bin/mkdir -p /var/lib/$DEBIAN_NAME/data
/bin/chown -R $USER_NAME:$GROUP_NAME /var/lib/$DEBIAN_NAME
/bin/chmod 750 /var/lib/$DEBIAN_NAME

/bin/mkdir -p /var/log/$DEBIAN_NAME
/bin/chown -R $USER_NAME:$GROUP_NAME /var/log/$DEBIAN_NAME
/bin/chmod 750 /var/log/$DEBIAN_NAME

if [ -e /var/lib/$DEBIAN_NAME/application.yml ] && [ -e /var/lib/$DEBIAN_NAME/application.yml.do_not_edit ]; then
  cp /var/lib/$DEBIAN_NAME/application.yml /var/lib/$DEBIAN_NAME/application.yml.package
  cp /var/lib/$DEBIAN_NAME/application.yml.do_not_edit /var/lib/$DEBIAN_NAME/application.yml
  rm -f /var/lib/$DEBIAN_NAME/application.yml.do_not_edit
fi
if [ -e /etc/$APP_NAME.conf ] && [ -e /etc/$APP_NAME.conf.do_not_edit ]; then
  cp /etc/$APP_NAME.conf /etc/$APP_NAME.conf.package
  cp /etc/$APP_NAME.conf.do_not_edit /etc/$APP_NAME.conf
  rm -f /etc/$APP_NAME.conf.do_not_edit
fi

/bin/systemctl enable $DEBIAN_NAME.service
/bin/systemctl start $DEBIAN_NAME.service

exit 0